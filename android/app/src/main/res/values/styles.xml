<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ (and the core-splashscreen compat back to API 23)
             draw the OS splash frame from these two attrs, NOT from a
             full-bleed android:background: windowSplashScreenBackground is
             the solid ground (navy, matching the splash artwork's own dark
             sky/pavement and capacitor.config.ts's backgroundColor), and
             the OS centres the app's launcher icon on it. The full splash
             photo (@drawable/splash / androidScaleType FIT_CENTER) is shown
             by the Capacitor plugin's own splash view once it takes over,
             and again by the web splash overlay after the WebView loads. -->
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <!-- Required by core-splashscreen: the theme the Activity switches
             to once the splash is dismissed (otherwise it keeps the splash
             as its window background). -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- Splash is a dark navy photo — without this, status bar icon
             color is left to the OS default, which on a DayNight/light-app
             device chain can default to dark icons (near-invisible against
             the navy splash). windowLightStatusBar=false forces white
             icons. statusBarColor/navigationBarColor are belt-and-suspenders
             for pre-edge-to-edge devices; ignored (harmlessly) on API 35+,
             which enforces edge-to-edge and draws system bars transparently
             regardless of this attribute. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/splashBackground</item>
        <item name="android:navigationBarColor">@color/splashBackground</item>
    </style>
</resources>