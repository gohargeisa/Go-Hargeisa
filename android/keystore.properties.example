# Copy this file to `keystore.properties` (same directory, android/) and
# fill in your own values. keystore.properties itself is git-ignored — never
# commit real signing credentials. See MOBILE_DEPLOYMENT.md for how to
# generate the .jks keystore file referenced by storeFile.
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=gohargeisa
keyPassword=CHANGE_ME
